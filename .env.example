APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8080
PUBLIC_BASE_URL=http://keuringen-web01.intern.example:8080

POSTGRES_HOST=<DATABASE-IP-OF-DNS>
POSTGRES_PORT=5432
POSTGRES_DB=keuringen
POSTGRES_USER=keuringen_app
POSTGRES_PASSWORD=<STERK-UNIEK-WACHTWOORD>

REDIS_URL=redis://redis:6379/0

# DOCUMENT_STORAGE_PATH is the path *inside the container* - leave this as
# /data/documents. DOCUMENT_HOST_PATH is the actual path *on the host* that
# gets bind-mounted there (read by docker-compose.yml, not by the app
# itself). Point it at your NAS mount, e.g. after mounting per docs/20 §12:
#   findmnt /mnt/keuringen-documents   # confirm the NAS mount is present
DOCUMENT_STORAGE_PATH=/data/documents
DOCUMENT_HOST_PATH=/mnt/keuringen-documents

AI_GATEWAY_URL=https://<AI-GATEWAY-DNS>

JWT_SECRET=<MINSTENS-32-WILLEKEURIGE-BYTES>
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

TOTP_ENCRYPTION_KEY=<MINSTENS-32-WILLEKEURIGE-BYTES>

WEBAUTHN_RP_ID=keuringen-web01.intern.example
WEBAUTHN_ORIGIN=http://keuringen-web01.intern.example:8080

# Branch this deployment tracks - used only by the read-only "update
# available" check on the Systeemstatus page (compares the running commit
# to origin/<REPO_BRANCH>). Set to your actual deployed branch until it is
# merged to main.
REPO_BRANCH=main

# Optional: only used by `python -m app.seed` to bootstrap the first
# system administrator account (including an initial TOTP method, so the
# account is never locked out by the strong-authentication policy).
# SEED_ADMIN_EMAIL=admin@example.org
# SEED_ADMIN_PASSWORD=change-me
